# API
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY backend/AiBrandStudio.sln ./
COPY backend/src ./src
COPY backend/tests ./tests
RUN dotnet restore AiBrandStudio.sln
RUN dotnet publish src/AiBrandStudio.Api/AiBrandStudio.Api.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "AiBrandStudio.Api.dll"]

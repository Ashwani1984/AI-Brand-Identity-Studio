# Application
ASPNETCORE_ENVIRONMENT=Development
API_URL=http://localhost:5080
NEXT_PUBLIC_API_URL=http://localhost:5080
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=AiBrandStudio;User Id=sa;Password=Your_strong_Password123;TrustServerCertificate=True;

# Redis
ConnectionStrings__Redis=localhost:6379

# JWT
Jwt__Issuer=AiBrandStudio
Jwt__Audience=AiBrandStudio
Jwt__Key=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=14

# Storage
Storage__Provider=Local
Storage__LocalPath=./storage
Storage__AzureBlobConnection=
Storage__AzureBlobContainer=assets

# AI Providers (leave empty to use mock fallback)
AI__OpenAI__ApiKey=
AI__OpenAI__Model=gpt-4o-mini
AI__Gemini__ApiKey=
AI__Gemini__Model=gemini-2.0-flash
AI__Ideogram__ApiKey=
AI__DefaultTextProvider=Mock
AI__DefaultImageProvider=Mock

# OAuth (optional Phase 1 hooks)
OAuth__Google__ClientId=
OAuth__Google__ClientSecret=
OAuth__Microsoft__ClientId=
OAuth__Microsoft__ClientSecret=
OAuth__GitHub__ClientId=
OAuth__GitHub__ClientSecret=

# Razorpay
Razorpay__KeyId=
Razorpay__KeySecret=
Razorpay__WebhookSecret=

# Credits
Credits__SignupBonus=50
Credits__BrandGenerate=5
Credits__LogoGenerate=8
Credits__PaletteGenerate=2
